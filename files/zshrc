# prevent brew from bloating the system over time
export HOMEBREW_INSTALL_CLEANUP=1
export HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS=1

[ "$(arch)" = "arm64" ] && [ -f "/opt/homebrew/bin/brew" ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ "$(arch)" = "i386" ] && [ -f "/usr/local/bin/brew" ] && eval "$(/usr/local/bin/brew shellenv)"

# Homebrew zsh upgrades change the versioned Cellar functions path. Keep fpath
# on stable symlinked directories so autoloaded helpers like compinit survive.
for zsh_functions_dir in /opt/homebrew/share/zsh/functions /usr/local/share/zsh/functions; do
  fpath=("${(@)fpath:#${zsh_functions_dir:h:h:h}/Cellar/zsh/*/share/zsh/functions}")
  [ -d "$zsh_functions_dir" ] && fpath=("$zsh_functions_dir" $fpath)
done
unset zsh_functions_dir
typeset -U fpath

platform='unknown'
unamestr=`uname`
if [[ "$unamestr" == 'Linux' ]]; then
   platform='linux'
   export PROMPT='%~ %# '
elif [[ "$unamestr" == 'Darwin' ]]; then
   platform='osx'
fi

if [ -d $HOME/.oh-my-zsh ]; then
  ZSH=$HOME/.oh-my-zsh
  ZSH_THEME="robbyrussell"
  # todo: switch to pythonic stack
  plugins=(bundler rake cp gem git vi-mode sudo ruby brew z)
  source $ZSH/oh-my-zsh.sh
  autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
fi

path=(
  "$HOME/.cargo/bin"
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/bin
  /bin
  /usr/sbin
  /sbin
  /usr/local/git/bin
  /usr/local/bin
  $path
)
typeset -U path

[ -d "$HOME/.local/bin" ] && export PATH="$PATH:$HOME/.local/bin"

export EDITOR='nvim'
export VISUAL='nvim'
export GNUTERM='X11'
if [ -n "$TMUX" ]; then
    export TERM="tmux-256color"
else
    export TERM="xterm-256color"
fi


bindkey -v # VIM binding for zsh

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

[ -f ~/.secret.sh ] && source ~/.secret.sh

[ -f $HOME/.oh-my-zsh/plugins/z/z.sh ] && . $HOME/.oh-my-zsh/plugins/z/z.sh

# https://github.com/SidOfc/dotfiles/blob/d07fa3862ed065c2a5a7f1160ae98416bfe2e1ee/zsh/kp
kp(){
  local pid=$(ps -ef | sed 1d | eval "fzf ${FZF_DEFAULT_OPTS} -m --header='[kill:process]'" | awk '{print $2}')
  if [ "x$pid" != "x" ]
  then
    echo $pid | xargs kill -${1:-9}
    kp
  fi
}

