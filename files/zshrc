function llm2() {
   if [ -t 0 ]; then
     echo "Using interactive chat mode"
       uvx llm "$@"
   else
      echo "Using standard input mode"
       cat - | uvx llm "$@"
   fi
}

function yt_download() {
  uvx --with yt-dlp yt-dlp \
    -f "bestvideo[ext=mp4][vcodec^=avc1][height<=1080]+bestaudio[ext=m4a][acodec^=mp4a]/best[ext=mp4][vcodec^=avc1]" \
    -o "%(title)s.%(ext)s" \
    --no-playlist \
    "$1"
}

function yt_rip_audio() {
  uvx --with 'yt-dlp[default]' yt-dlp \
    --js-runtimes node:/opt/homebrew/bin/node \
    -f 'bestaudio[ext=webm]/bestaudio' \
    --remux-video ogg \
    -o '%(title)s.%(ext)s' \
    --no-playlist \
    "$1"
}

